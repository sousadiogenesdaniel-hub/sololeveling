<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissões do app, e o motivo de cada uma. O app NÃO pede: Acessibilidade (ler a tela), acesso a
  notificações, SMS, contatos, microfone nem câmera própria (a foto usa o app de câmera do sistema).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- abrir o app web publicado e verificar se há versão nova -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ponto por GPS e rastreamento de atividades (já usados pelo app web) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- lembrete de missão pendente e aviso de Zona de Penalidade -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- serviço que mantém o bloqueio ativo enquanto houver Zona de Penalidade -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- rastrear caminhada/corrida/bike com a tela bloqueada (só enquanto você estiver rastreando) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Acesso ao uso": saber QUAL app está aberto (só o nome do pacote; nunca o conteúdo) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- "Sobrepor a outros apps": desenhar a tela de bloqueio por cima de WhatsApp/Gmail -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- religar o bloqueio e os lembretes depois de reiniciar o celular -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- conferir a virada do dia e o fim do desbloqueio de emergência na hora certa -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- pedir para o Android não matar o bloqueio para economizar bateria -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- vibração das comemorações -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- só para saber se os apps bloqueáveis estão instalados (Android 11+ exige declarar) -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="O Sistema"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bloqueio de apps escolhidos pelo usuário durante a Zona de Penalidade" />
        </service>

        <service
            android:name=".TrackerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver android:name=".AlarmReceiver" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
